.custom-contact-info
  .custom-contact-info__container
    .custom-contact-info__col
      .custom-contact-info__info-container
        SectionTitle(:title="'Address'", :color="'blue'")
        .custom-contact-info__information(v-html="props.address")
      .custom-contact-info__info-container
        SectionTitle(:title="'Phone'", :color="'blue'")
        .custom-contact-info__information(v-html="props.phone")
      .custom-contact-info__info-container
        SectionTitle(:title="'Hours'", :color="'blue'")
        .custom-contact-info__information(v-html="props.hours")
    a.custom-contact-info__col(:style="{'background' : 'url(' + props.map_image + ') no-repeat center / cover'}", :href="props.map_link")
  .custom-contact-info__background
