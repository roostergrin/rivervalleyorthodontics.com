.custom-about-doctor
  SectionTitle.custom-about-doctor__title(:title="props.title", :color="'green'", :size="'double'")
  .custom-about-doctor__container
    .custom-about-doctor__col-full
      .custom-about-doctor__title-container(v-for="(section, i) in props.sections", :class="{'custom-about-doctor__title-container--active' : activeIndex === i}", @click="updateActiveSection(i)")
        .custom-about-doctor__section-title {{ section.title }}
        BaseIcon.custom-about-doctor__icon(name="SingleWave150-Thin")
  .custom-about-doctor__photo(:style="{ 'background' : 'url(' + props.img + ') no-repeat top / cover'}")
    .custom-about-doctor__container
      .custom-about-doctor__col-full
        .custom-about-doctor__section-content {{ activeSection.content }}