.custom-home-testimonials
  SectionTitle.custom-home-testimonials__title(:title="props.title")
  .custom-home-testimonials__container
    .custom-home-testimonials__col
      .custom-home-testimonials__img(:style="{'background': 'url(' + activeTestimonial.img + ') no-repeat center / cover'}")
      .custom-home-testimonials__background
    .custom-home-testimonials__col
      .custom-home-testimonials__author {{ activeTestimonial.author }}
      .custom-home-testimonials__text(v-html="activeTestimonial.text")
      .custom-home-testimonials__date {{ activeTestimonial.date }}
      .custom-home-testimonials__dots-container
        .custom-home-testimonials__dot(v-for="(dot, i) in testimonials", :class="{'custom-home-testimonials__dot--active' : currentIndex === i }" @click="jumpToIndex(i)")
      a.custom-home-testimonials__google-link(:href="businessPageLink", target="_blank", rel="noopener noreferrer") Read more Google reviews
