.nav-desktop(v-if="links", :class="{ 'nav-desktop--hide' : navState === 'hide', 'nav-desktop--top' : navState === 'top' }")
  .nav-desktop__top
    BaseIcon.nav-desktop__logo(name="Header-Logo-Full", :class="{'nav-desktop__logo--hide': navState}" @click.native="redirectHome")
    .nav-desktop__active-link {{ activeRoute }}
  .nav-desktop__bottom
  BaseIcon.nav-desktop__logo-small(name="Header-Logo-Minimal" @click.native="redirectHome")
  .nav-desktop__container
    .nav-desktop__row
      a.nav-desktop__phone-container(href="tel:208-678-3265")
        BaseIcon.nav-desktop__phone(name="Phone")
        .nav-desktop__phone-number 208-678-3265
      a.nav-desktop__button(href='https://book2.getweave.com/0d34186c-77a2-46f7-822a-fed881d6ef00/request-appointment?source=WEBSITE') Click Here to Schedule Your Free Consultation
    .nav-desktop__row
      router-link.nav-desktop__link(v-for="(link, i) in links", :key="i", :to="link.path", v-html="link.name")
