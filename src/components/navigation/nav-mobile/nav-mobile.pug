.nav-mobile(v-if="links", :class="{'nav-mobile--open' : drawerState}")
  .nav-mobile__top-container
    BaseIcon.nav-mobile__icon(name="Header-Logo-Minimal" @click.native="redirectHome")
    MenuButton.nav-mobile__menu-icon(@click.native="toggleDrawer")
  .nav-mobile__menu
    .nav-mobile__menu-wrapper
      .nav-mobile__links-container
        span(v-for='(link, i) in links', :key="i")
          router-link.nav-mobile__link(:to="link") {{ link.name }}
      .nav-mobile__info-container
        a.nav-mobile__button.nav-mobile__button--complimentary(
          v-if="navigation.schedule_link",
          :href="navigation.schedule_link",
          target="_blank",
          rel="noopener noreferrer"
        ) {{ navigation.schedule_text }}
        //- a.nav-mobile__button.nav-mobile__button--rewards(:href="navigation.rewards_hub_link") rewards hub
        //- a.nav-mobile__phone(:href="'tel:' + formatPhone") {{ navigation.phone_number}}
        //- .nav-mobile__hours {{ navigation.hours }}
