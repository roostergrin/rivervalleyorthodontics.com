.block-hero-video
  .block-hero-video__bg
    video(ref="hero", :src="props", loop, playsinline, autoplay, muted, @play="syncPlaybackState", @pause="syncPlaybackState", @volumechange="syncMuteState")
    .block-hero-video__controls
      button.block-hero-video__video-control.block-hero-video__video-control--playback(
        type="button",
        :aria-label="isPlaying ? 'Pause video' : 'Play video'",
        @click="toggleVideoState"
      ) {{ isPlaying ? 'Pause Video' : 'Play Video' }}
      button.block-hero-video__video-control.block-hero-video__video-control--sound(
        type="button",
        :aria-label="isMuted ? 'Unmute video' : 'Mute video'",
        :aria-pressed="isMuted ? 'false' : 'true'",
        @click="toggleMute"
      )
        svg(aria-hidden="true", focusable="false", viewBox="0 0 24 24")
          path.block-hero-video__speaker(d="M4 9v6h4l5 4V5L8 9H4")
          g(v-if="isMuted")
            path(d="M16 9l5 6")
            path(d="M21 9l-5 6")
          g(v-else)
            path(d="M16 8.5c1.25 1.25 1.25 5.75 0 7")
            path(d="M19 6c3 3 3 9 0 12")
