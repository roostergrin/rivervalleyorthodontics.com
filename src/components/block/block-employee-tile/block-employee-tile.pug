.block-employee-tile( @click="toggleState", :style="{ 'background': tileBackground }", :class="{'block-employee-tile--active': active, 'block-employee-tile--long-position': props.position && props.position.length > 30 }")
  .block-employee-tile__employee-info 
    .block-employee-tile__name {{ props.name }}
    .block-employee-tile__position(v-if="props.position") {{ props.position }}
    .block-employee-tile__bio {{ props.bio }}
