footer.the-footer(v-if="props")

  .the-footer__left-container
    .the-footer__section
      .the-footer__title Address
      .the-footer__content
        .the-footer__text(v-html="address")
    .the-footer__section
      .the-footer__title Phone
      .the-footer__content
        .the-footer__text {{ phone }}
  .the-footer__logo-container
    BaseIcon.the-footer__logo(name="Header-Logo-Full" @click.native="scrollToTop")
    .the-footer__logo-text Click logo to return to the top

  .the-footer__right-container
    .the-footer__section
      .the-footer__title Follow Us
      .the-footer__content
        BaseIcon.the-footer__icon(:name="social.icon_name", v-for="(social, i) in socials", :key="i")
    .the-footer__section
      .the-footer__title Hours
      .the-footer__content.the-footer__flex-column(v-html="hours")
